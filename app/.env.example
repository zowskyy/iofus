# iofus environment variables
# Copy to .env.local and fill in values for your deployment.

# Path to the SQLite database file (default: ./iofus.db, Docker: /data/iofus.db)
# IOFUS_DB_PATH=/data/iofus.db

# Handle to promote as moderator on first boot
# IOFUS_MODERATOR_HANDLE=youradmin

# Production domain for server action origin validation (e.g. iofus.example.com)
# IOFUS_ALLOWED_ORIGIN=iofus.example.com

# --- Development only ---

# Auto-promote first user as moderator (never use in production)
# IOFUS_AUTO_MODERATOR_SEED=true

# Disable rate limits (testing only)
# IOFUS_DISABLE_RATE_LIMIT=true
